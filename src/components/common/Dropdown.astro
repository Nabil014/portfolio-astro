---
import { language } from '../../i18n/ui'
import ArgSvg from '../../assets/icons/ArgSvg.astro'
import EnSvg from '../../assets/icons/EnSvg.astro'
import LanguageSvg from '../../assets/icons/LanguageSvg.astro'

interface Props {
  text: string
}

const { text } = Astro.props
---

<div class='relative' data-dropdown>
  <button
    type='button'
    data-dropdown-button
    aria-haspopup='true'
    aria-expanded='false'
    class='text-white gap-x-1 focus:outline-none rounded-lg text-md px-5 py-2.5 text-center inline-flex items-center'
  >
    <LanguageSvg />
    {text}
    <svg
      class='w-2.5 h-2.5 ms-3 transition-transform duration-300'
      fill='none'
      viewBox='0 0 10 6'
      data-dropdown-arrow
    >
      <path
        stroke='currentColor'
        stroke-linecap='round'
        stroke-linejoin='round'
        stroke-width='2'
        d='m1 1 4 4 4-4'
      ></path>
    </svg>
  </button>

  <div
    data-dropdown-menu
    class='z-10 hidden absolute top-12 left-3 bg-white rounded-lg shadow w-32'
  >
    <ul class='py-2 text-sm text-gray-800 font-Ubuntu'>
      {
        Object.entries(language).map(([lang, label]) => (
          <li>
            <a
              href={lang === 'es' ? '/' : `/${lang}/`}
              hreflang={lang}
              class='flex items-center px-2 py-2 hover:bg-[#FFE3BB]'
            >
              {lang === 'en' ? <EnSvg /> : <ArgSvg />}
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<script>
  // Funciona con varias instancias (menú de escritorio y menú móvil).
  const dropdowns = document.querySelectorAll<HTMLElement>('[data-dropdown]')

  const setOpen = (dropdown: HTMLElement, open: boolean) => {
    dropdown.querySelector('[data-dropdown-menu]')?.classList.toggle('hidden', !open)
    dropdown.querySelector('[data-dropdown-arrow]')?.classList.toggle('rotate-180', open)
    dropdown
      .querySelector('[data-dropdown-button]')
      ?.setAttribute('aria-expanded', String(open))
  }

  dropdowns.forEach((dropdown) => {
    const button = dropdown.querySelector('[data-dropdown-button]')
    const menu = dropdown.querySelector('[data-dropdown-menu]')

    button?.addEventListener('click', (e) => {
      e.stopPropagation()
      setOpen(dropdown, menu?.classList.contains('hidden') ?? false)
    })
  })

  document.addEventListener('click', () => {
    dropdowns.forEach((dropdown) => setOpen(dropdown, false))
  })
</script>
