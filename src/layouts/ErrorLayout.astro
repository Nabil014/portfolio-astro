---
import NavbarError from '../components/NavbarError.astro'
import Head from '../components/Head.astro'
import { getLangFromUrl } from '../i18n/utils'

interface Props {
  title: string
}

const { title } = Astro.props
const lang = getLangFromUrl(Astro.url)
---

<!doctype html>
<html lang={lang}>
  <head>
    <Head title={title} lang={lang} />
  </head>
  <body class='bg-[#e9e9e7]'>
    <nav
      class='z-50 max-w-6xl mx-auto sticky top-0'
      id='navbar'
    >
      <NavbarError />
    </nav>
    <slot />
  </body>
</html>

<style is:global>
  html {
    font-family: system-ui, sans-serif;
    background-size: 224px;
    scroll-behavior: smooth;
  }
</style>
