---
import Background from '../components/Backgroun.astro'
import Navbar from '../components/Navbar.astro'
import Home from '../components/Home.astro'
import Experience from '../components/Experience.astro'
import Projects from '../components/Projects/Projects.astro'
import Contact from '../components/Contact.astro'
import Head from '../components/Head.astro'
import { getLangFromUrl } from '../i18n/utils'
interface Props {
  title: string
}

const { title } = Astro.props
const lang = getLangFromUrl(Astro.url)
---

<!doctype html>
<html lang={lang}>
  <head>
    <Head title={title} lang={lang} />
  </head>
  <body>
    <div>
      <Background />
    </div>
    <nav
      class='z-50 max-w-6xl mx-auto sticky top-0'
      id='navbar'
    >
      <Navbar />
    </nav>
    <main class='max-w-5xl mx-auto'>
      <section id='home'>
        <Home />
      </section>
      <div class='w-full h-[2px] bg-neutral-800 hidden md:block'></div>
      <section
        id='experience'
        class='pb-10 md:pb-0'
      >
        <Experience />
      </section>
      <div class='w-full h-[2px] bg-neutral-800 hidden md:block'></div>

      <section
        id='projects'
        class='mb-20'
      >
        <Projects />
      </section>
      <section id='contact'>
        <Contact />
      </section>
    </main>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --accent: 136, 58, 234;
    --accent-light: 224, 204, 250;
    --accent-dark: 49, 10, 101;
    --accent-gradient: linear-gradient(
      45deg,
      rgb(var(--accent)),
      rgb(var(--accent-light)) 30%,
      white 60%
    );
  }
  html {
    font-family: system-ui, sans-serif;
    background-size: 224px;
    scroll-behavior: smooth;
  }
</style>
